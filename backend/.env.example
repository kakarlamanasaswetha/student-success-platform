# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/student_success?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/student_success

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# OpenAI (optional — leave blank to run in demo/mock mode with realistic canned AI responses)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS
CLIENT_URL=http://localhost:5173

# Risk engine thresholds. NOT a plain 0-100 scale: the weighted formula in
# riskScoreService.js realistically outputs ~5-10 for solid standing, ~15-20 for
# moderate concern, and ~30-40 for multiple simultaneous red flags (near-failing
# grade + high missing-work rate + weak attendance) — 55+ requires combined failure
# across nearly every axis. Calibrated against the seeded demo data; if you change
# the scoring weights in riskScoreService.js, re-check these against real output.
RISK_HIGH_THRESHOLD=55
RISK_MEDIUM_THRESHOLD=30
